[
  {
    "op": "replace",
    "path": "/spec/template/spec/volumes",
    "value": [
      {"name": "tmp-volume", "emptyDir": {"medium": "Memory"}},
      {"name": "catalog-secrets", "csi": {"driver": "secrets-store.csi.k8s.io", "readOnly": true, "volumeAttributes": {"secretProviderClass": "catalog-db-secrets"}}}
    ]
  },
  {
    "op": "replace",
    "path": "/spec/template/spec/containers/0/volumeMounts",
    "value": [
      {"name": "tmp-volume", "mountPath": "/tmp"},
      {"name": "catalog-secrets", "mountPath": "/mnt/secrets-store", "readOnly": true}
    ]
  }
]
